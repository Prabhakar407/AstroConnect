{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{.archive/**,.impeccable/**,docs/**,tests/**,scripts/**,src/assets/**,src/Component/**,public/**,dist/**,node_modules/**,**/__pycache__/**,**/.env*,src/backend/tests/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Vercel-Enable-Rewrite-Caching", "value": "0" }
      ]
    }
  ]
}
