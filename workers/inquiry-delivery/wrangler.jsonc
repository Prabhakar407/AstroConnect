{
  "name": "astro-advice-inquiry-delivery",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/15 * * * *"] },
  "queues": {
    "consumers": [{
      "queue": "astro-advice-inquiries",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      "max_retries": 5,
      "retry_delay": 60,
      "max_concurrency": 1
    }]
  },
  "observability": { "enabled": true }
}
